# Operator credentials for `npm run new-client`. This file is DIFFERENT from
# `.env` (which holds a single client's runtime config) — this one holds
# YOUR OWN API tokens used only to provision new client infrastructure.
# Copy to `.env.automation` and fill in real values. Never commit that file
# (it's covered by the .env* entry in .gitignore).

# GitHub personal access token with `repo` scope (and `admin:org` if
# AUTOMATION_GITHUB_OWNER is an org, not your personal account).
# Generate at https://github.com/settings/tokens
AUTOMATION_GITHUB_TOKEN=""

# The GitHub user or org login to create new client repos under.
AUTOMATION_GITHUB_OWNER=""

# The owner/name of THIS template repo, used as the "generate from template" source.
AUTOMATION_TEMPLATE_OWNER=""
AUTOMATION_TEMPLATE_REPO="client-site-template"

# Neon API key (account settings -> API Keys) - creates one Neon project per client.
AUTOMATION_NEON_API_KEY=""
# Optional: Neon org ID, if your API key needs to create projects under an org.
AUTOMATION_NEON_ORG_ID=""

# Cloudflare API token scoped to R2 (edit) + account membership (read).
# Cloudflare dashboard -> My Profile -> API Tokens -> Create Token.
AUTOMATION_CLOUDFLARE_API_TOKEN=""
# Cloudflare dashboard -> Account Home -> Account ID (right sidebar).
AUTOMATION_CLOUDFLARE_ACCOUNT_ID=""

# Vercel API token (account settings -> Tokens).
AUTOMATION_VERCEL_API_TOKEN=""
# Optional: Vercel team ID, if projects should be created under a team, not
# your personal account.
AUTOMATION_VERCEL_TEAM_ID=""
