# Copy this file to .env and fill in real values for local development.
# For deployment, see TEMPLATE-SETUP.md. On Vercel, every var below is set
# once as a normal Project Environment Variable - there's no separate
# "build variable" distinction (that only applies to the optional Docker/
# self-host path, see TEMPLATE-SETUP.md's appendix).
#
# Provisioning a new client? `npm run new-client -- --name <slug>` generates
# most of this automatically into new-client-output/<slug>.env - see
# TEMPLATE-SETUP.md section 0.

# Postgres connection string (Neon) - one project per client
# (build-time: /sitemap.xml and /robots.txt are prerendered against the DB)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js - generate with `npx auth secret`
# (build-time: read by the Auth.js config during the build's page-data pass)
AUTH_SECRET=""

# Only needed when self-hosting behind a reverse proxy (Coolify/Traefik) -
# tells Auth.js to trust the incoming Host header. Leave unset on Vercel
# (Auth.js auto-trusts the host there) and leave unset for local `npm run dev`.
AUTH_TRUST_HOST=""

# Public site URL (used for absolute links, sitemap, OG images)
# (build-time: NEXT_PUBLIC_* vars are inlined into the client bundle)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudflare R2 (S3-compatible media storage)
# R2_ACCOUNT_ID: Cloudflare dashboard -> R2 -> Account ID
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: R2 -> Manage API Tokens -> create token
# R2_BUCKET_NAME: the bucket created for this client
# R2_PUBLIC_URL: the bucket's public access URL (custom domain or r2.dev), no trailing
# slash. (build-time: baked into next/image's allowed remote patterns)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Resend (contact form email notifications)
# RESEND_API_KEY: resend.com dashboard -> API Keys. Leave empty to skip sending
# notification emails (form submissions are still stored in the database).
# RESEND_FROM_EMAIL: a verified sender, e.g. "Acme <notifications@acme.com>"
# CONTACT_EMAIL_TO: where new contact form submissions are sent (falls back to
# the contact email set in /admin/settings if empty)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
CONTACT_EMAIL_TO=""

# Cloudflare Web Analytics
# Cloudflare dashboard -> Analytics & Logs -> Web Analytics -> site token.
# Falls back to the token set in /admin/settings if empty.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=""
